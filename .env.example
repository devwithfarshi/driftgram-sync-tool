# Get these from https://my.telegram.org/apps (log in with the Telegram
# account you want the sync tool to use, then create an "app" - any name/platform is fine).
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Any name you like. Telethon creates "<name>.session" next to this file
# after your first login - that file IS your login, so never share or commit it.
TG_SESSION_NAME=d_drive_sync
