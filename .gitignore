# ---------------------------------------------------------------------------
# Credentials. Anything below this heading is equivalent to being logged into
# the Telegram account Driftgram runs as - never commit it.
# ---------------------------------------------------------------------------

# .env holds TG_API_ID / TG_API_HASH. The wildcard catches the variants people
# make by hand (.env.local, .env.backup, .env.old) without needing to think
# about it; .env.example is the one deliberate exception and is re-included.
.env
.env.*
!.env.example

# The Telegram session file IS the login. SQLite writes sidecars next to it
# (-journal, -wal, -shm) that can hold the same data, so match all of them -
# src/app/supervisor.py deletes exactly these on sign-out for the same reason.
*.session
*.session-*

# config.yaml may contain api_hash (the setup wizard writes it there) as well
# as personal folder paths. config.example.yaml is a separate name and stays.
config.yaml

# ---------------------------------------------------------------------------
# Per-machine state. Not secret, but meaningless on anyone else's computer.
# ---------------------------------------------------------------------------

# The sync manifest, plus its WAL sidecars (state.py sets journal_mode=WAL).
manifest.db
manifest.db-*

driftgram.lock
driftgram.log
driftgram.log.*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------

# PyInstaller work and output directories, the staged AppDir and .deb trees,
# the downloaded appimagetool, and the Inno Setup output all land in one of
# these two.
build/
dist/

# Icons are generated from src/gui/icons.py at build time by
# packaging/make_icons.py, so they are output, not source.
packaging/generated/

# Stray PyInstaller specs. Running `pyinstaller packaging/entry.py` instead of
# passing the real spec drops a generated entry.spec in the working directory;
# this catches it. Anchored with a leading slash so it applies to the repo root
# ONLY - packaging/driftgram.spec is hand-written and must stay tracked, so do
# not relax this to a bare *.spec.
/*.spec

# Output of `python tools/screenshot.py`.
screenshots/

# ---------------------------------------------------------------------------
# Editors and OS clutter
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Landing page (web/)
# ---------------------------------------------------------------------------

# Tailwind's toolchain.
web/node_modules/

# The compiled stylesheet IS committed, so the page can be served as plain
# static files with no build step. The build/ + dist/ rules above are written
# for PyInstaller's output and match a directory called dist at ANY depth, so
# without these two lines web/dist/styles.css is silently dropped and the
# deployed site loads with no CSS. Git cannot re-include a file whose parent
# directory is excluded, so the directory has to be un-ignored first.
!web/dist/
!web/dist/styles.css
